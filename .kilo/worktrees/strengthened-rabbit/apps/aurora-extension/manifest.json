{
  "manifest_version": 3,
  "name": "AURORA Kaushal IDM",
  "version": "0.1.0",
  "description": "High-performance adaptive multi-connection download manager powered by pure WebAssembly and ECT scheduling.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AURORA Kaushal IDM",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/interceptor.js"],
      "css": ["content/interceptor.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pkg/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
