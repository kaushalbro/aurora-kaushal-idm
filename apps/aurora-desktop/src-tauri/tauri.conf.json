{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AURORA Kaushal Download Manager",
  "version": "0.3.0",
  "identifier": "com.aurora.kaushal.idm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AURORA Kaushal Download Manager - Nepal",
        "width": 1080,
        "height": 700,
        "minWidth": 800,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
